\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Sensitivity analysis for the aptitude--achievement paradox probability under the setting of Theorem~\ref {theorem:samedistgeneral}. Panel (A) fixes $n_1=40$ and $n_2=60$ and varies $N_1$ and $N_2$. Panel (B) fixes $N_1=N_2=10^3$ and varies $n_1$ and $n_2$. Panel (C) fixes $n_1=40$ and $N_2=10^3$ and varies $n_2$ and $N_1$. Panel (D) fixes $n_2=60$ and $N_1=10^3$ and varies $n_1$ and $N_2$.}}{19}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{Fig:sensitivity}{{1}{19}{Sensitivity analysis for the aptitude--achievement paradox probability under the setting of Theorem~\ref {theorem:samedistgeneral}. Panel (A) fixes $n_1=40$ and $n_2=60$ and varies $N_1$ and $N_2$. Panel (B) fixes $N_1=N_2=10^3$ and varies $n_1$ and $n_2$. Panel (C) fixes $n_1=40$ and $N_2=10^3$ and varies $n_2$ and $N_1$. Panel (D) fixes $n_2=60$ and $N_1=10^3$ and varies $n_1$ and $N_2$}{figure.caption.1}{}}

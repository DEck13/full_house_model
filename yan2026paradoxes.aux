\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Effect of the population-size ratio $c=N_2/N_1$ on aptitude--achievement paradox probabilities under the specifications of Corollary~\ref {corollary:samedisttop}. The observed sample sizes are fixed at $n_1=60$ and $n_2=40$, while $N_1$ varies from $100$ to $2000$ and $N_2=cN_1$. The four panels correspond to $j=k=0,1,2,3$, respectively, that is, comparisons of the first through fourth largest achievers.}}{22}{figure.caption.2}\protected@file@percent }
\newlabel{Fig:ratioeffect}{{2}{22}{Effect of the population-size ratio $c=N_2/N_1$ on aptitude--achievement paradox probabilities under the specifications of Corollary~\ref {corollary:samedisttop}. The observed sample sizes are fixed at $n_1=60$ and $n_2=40$, while $N_1$ varies from $100$ to $2000$ and $N_2=cN_1$. The four panels correspond to $j=k=0,1,2,3$, respectively, that is, comparisons of the first through fourth largest achievers}{figure.caption.2}{}}

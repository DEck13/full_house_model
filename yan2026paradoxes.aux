\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Sensitivity analysis under Theorem~\ref {theorem:samedistgeneral} for $k=1$ (second-largest achiever) with $Y\sim \mathcal  N(0,1)$ and $X\sim \mathrm  {Pareto}(1.16)$. Panel (A) fixes $(n_1,n_2)=(40,60)$ and varies $(N_1,N_2)$. Panel (B) fixes $(N_1,N_2)=(10^3,10^3)$ and varies $(n_1,n_2)$. Panel (C) fixes $(n_1,N_2)=(40,10^3)$ and varies $(n_2,N_1)$. Panel (D) fixes $(n_2,N_1)=(60,10^3)$ and varies $(n_1,N_2)$.}}{28}{figure.caption.3}\protected@file@percent }
\newlabel{Fig:sensitivity_k1_normal}{{1}{28}{Sensitivity analysis under Theorem~\ref {theorem:samedistgeneral} for $k=1$ (second-largest achiever) with $Y\sim \mathcal N(0,1)$ and $X\sim \mathrm {Pareto}(1.16)$. Panel (A) fixes $(n_1,n_2)=(40,60)$ and varies $(N_1,N_2)$. Panel (B) fixes $(N_1,N_2)=(10^3,10^3)$ and varies $(n_1,n_2)$. Panel (C) fixes $(n_1,N_2)=(40,10^3)$ and varies $(n_2,N_1)$. Panel (D) fixes $(n_2,N_1)=(60,10^3)$ and varies $(n_1,N_2)$}{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Effect of the population-size ratio $c=N_2/N_1$ on the paradox probability under Corollary~\ref {corollary:samedisttop} with $Y\sim \mathcal  N(0,1)$. We fix $(n_1,n_2)=(60,40)$, vary $N_1\in \{100,\ldots  ,2000\}$, and set $N_2=cN_1$ with $c\in \{0.1,\ldots  ,1.0\}$. Panels correspond to $k=0,1,2,3$ (largest through fourth-largest achiever). Curves for larger values of \(c\) may overlap at horizontal axis. In particular, for \(k=0\), Corollary~\ref {corollary:samedisttop} gives a positive paradox probability only when \(c=N_2/N_1\leq n_2/n_1=2/3\); hence the curves for \(c>2/3\) collapse to the horizontal axis.}}{29}{figure.caption.4}\protected@file@percent }
\newlabel{Fig:ratioeffect}{{2}{29}{Effect of the population-size ratio $c=N_2/N_1$ on the paradox probability under Corollary~\ref {corollary:samedisttop} with $Y\sim \mathcal N(0,1)$. We fix $(n_1,n_2)=(60,40)$, vary $N_1\in \{100,\ldots ,2000\}$, and set $N_2=cN_1$ with $c\in \{0.1,\ldots ,1.0\}$. Panels correspond to $k=0,1,2,3$ (largest through fourth-largest achiever). Curves for larger values of \(c\) may overlap at horizontal axis. In particular, for \(k=0\), Corollary~\ref {corollary:samedisttop} gives a positive paradox probability only when \(c=N_2/N_1\leq n_2/n_1=2/3\); hence the curves for \(c>2/3\) collapse to the horizontal axis}{figure.caption.4}{}}

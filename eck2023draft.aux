\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Batting average performances that are at least as extreme as Luis Arraez in 2023. Extreme as defined by the value $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle F$}\mathaccent "0362{F}(Y_{(n_i),i})^{n_i}$ where $i$ denotes the season, $n_i$ denotes the number of full-time players in season $i$, $Y_{(n_i),i}$ denotes the highest batting average for full-time players in season $i$, and $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle F$}\mathaccent "0362{F}$ is the distribution function of the normal distribution with sample mean and standard deviation estimators substituted for the population parameters. This table also includes the year, name, and raw batting average of extreme performers. It also includes the number of full-time players (n), and a Shapiro Wilk p-value corresponding to a test against normality for the batting average distribution for full-time players.}}{22}{table.caption.7}\protected@file@percent }
\newlabel{Tab:extreme-performers}{{1}{22}{Batting average performances that are at least as extreme as Luis Arraez in 2023. Extreme as defined by the value $\widehat {F}(Y_{(n_i),i})^{n_i}$ where $i$ denotes the season, $n_i$ denotes the number of full-time players in season $i$, $Y_{(n_i),i}$ denotes the highest batting average for full-time players in season $i$, and $\widehat {F}$ is the distribution function of the normal distribution with sample mean and standard deviation estimators substituted for the population parameters. This table also includes the year, name, and raw batting average of extreme performers. It also includes the number of full-time players (n), and a Shapiro Wilk p-value corresponding to a test against normality for the batting average distribution for full-time players}{table.caption.7}{}}
